rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master data: Allow public read, restrict write to prevent malicious deletions/wipes
    match /empresas/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /clientes/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /proveedores_mp/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /supervisores/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /tipos_caja/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /tipos_empaque/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /personal/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
    }
    match /turnos/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /labores/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /grupos/{id} {
      allow read: if true;
      allow write: if true;
    }
    match /programa_exportacion/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Transactional collections: Allow read and write, but prevent absolute database wipes
    match /recepciones_mp/{id} {
      allow read: if true;
      allow write: if request.resource.data.id == id && request.resource.data.lote_materia_prima != null;
      allow delete: if true;
    }
    match /calibrados_mp/{id} {
      allow read: if true;
      allow write: if request.resource.data.id == id && request.resource.data.lote_materia_prima != null;
      allow delete: if true;
    }
    match /productos/{id} {
      allow read: if true;
      allow write: if request.resource.data.nombre != null && request.resource.data.id == id;
      allow delete: if true;
    }
    match /produccion_diaria/{id} {
      allow read: if true;
      allow write: if request.resource.data.id == id && request.resource.data.fecha != null;
    }
    match /asistencia_diaria/{id} {
      allow read: if true;
      allow write: if request.resource.data.id == id && request.resource.data.fecha != null;
    }
    match /tareo_diario/{id} {
      allow read: if true;
      allow write: if request.resource.data.id == id && request.resource.data.fecha != null;
    }
  }
}
